{
  "title": "Defense Landing Zone Zero-Trust Observability",
  "schemaVersion": 38,
  "panels": [
    {
      "title": "IMDSv1 Insecure Calls (Target: 0)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(aws_ec2_imdsv1_calls_total[5m]))",
          "legendFormat": "IMDSv1 Violations"
        }
      ]
    },
    {
      "title": "NIST 800-53 Policy Denials / min",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(opa_stig_denials_total[5m]))",
          "legendFormat": "STIG Denials"
        }
      ]
    },
    {
      "title": "KMS FIPS-140 Cryptographic Latency (p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(aws_kms_request_latency_seconds_bucket[5m]))",
          "legendFormat": "p99 KMS Latency"
        }
      ]
    },
    {
      "title": "Air-Gapped Egress Boundary Drops",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(aws_network_firewall_dropped_packets_total[5m]))",
          "legendFormat": "Blocked Outbound Drops"
        }
      ]
    }
  ]
}